{
  "format_version": "1.19.0",
  "minecraft:block": {
    "description": {
      "states": {
        "addon:wall_connection_type_north": [ "false", "true" ],
        "addon:wall_connection_type_east": [ "false", "true" ],
        "addon:wall_connection_type_south": [ "false", "true" ],
        "addon:wall_connection_type_west": [ "false", "true" ]
      },
      "menu_category": {
        "group": "itemGroup.name.construction",
        "category": "construction"
      },
      "identifier": "addon:mossy_cobblestone_wall_slab"
    },
    "components": {
      "minecraft:display_name": "tile.addon:mossy_cobblestone_wall_slab.name",
      "minecraft:material_instances": {
        "*": {
          "texture": "mossy_cobblestone",
          "render_method": "opaque"
        }
      },
      "minecraft:geometry": "geometry.mini_wall",
      "minecraft:block_light_absorption": 0,
      "minecraft:loot": "self",
      "minecraft:on_player_placing": {
        "event": "addon:set_wall_connections"
      },
      "minecraft:destroy_time": 2.0
    },
    "events": {
      "addon:set_wall_connections": {
        "set_block_state": {
          "addon:wall_connection_type_north": "t.block_face == 2",
          "addon:wall_connection_type_south": "t.block_face == 3",
          "addon:wall_connection_type_west": "t.block_face == 4",
          "addon:wall_connection_type_east": "t.block_face == 5"
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('addon:wall_connection_type_north') == 'true'",
        "components": {
          "minecraft:geometry": {
            "identifier": "geometry.mini_wall",
            "bone_visibility": {
              "north": "true"
            }
          }
        }
      },
      {
        "condition": "q.block_state('addon:wall_connection_type_east') == 'true'",
        "components": {
          "minecraft:geometry": {
            "identifier": "geometry.mini_wall",
            "bone_visibility": {
              "east": "true"
            }
          }
        }
      },
      {
        "condition": "q.block_state('addon:wall_connection_type_south') == 'true'",
        "components": {
          "minecraft:geometry": {
            "identifier": "geometry.mini_wall",
            "bone_visibility": {
              "south": "true"
            }
          }
        }
      },
      {
        "condition": "q.block_state('addon:wall_connection_type_west') == 'true'",
        "components": {
          "minecraft:geometry": {
            "identifier": "geometry.mini_wall",
            "bone_visibility": {
              "west": "true"
            }
          }
        }
      }
    ]
  }
}